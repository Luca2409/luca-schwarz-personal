---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Datenschutz – Luca Schwarz"
  description="Datenschutzerklärung der Website von Luca Schwarz."
>
  <Header />

  <main class="legal-page">
    <div class="container legal-content">
      <div class="eyebrow">Rechtliches</div>
      <h1>Datenschutz</h1>

      <p>
        <strong>Platzhalter:</strong> Diese Seite ist noch keine vollständige
        Datenschutzerklärung. Ergänze sie passend zu Hosting, Kontaktformular,
        Analytics, Fonts, Cookies und allen tatsächlich eingesetzten Diensten.
      </p>

      <h2>Hosting</h2>
      <p>Hier den später verwendeten Hosting-Anbieter eintragen.</p>

      <h2>Kontakt</h2>
      <p>
        Wenn Kontakt ausschließlich per E-Mail erfolgt, sollte auch die
        Verarbeitung der dabei übermittelten personenbezogenen Daten erläutert
        werden.
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>
