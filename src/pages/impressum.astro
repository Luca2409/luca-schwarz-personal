---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Impressum – Luca Schwarz"
  description="Impressum der Website von Luca Schwarz."
>
  <Header />

  <main class="legal-page">
    <div class="container legal-content">
      <div class="eyebrow">Rechtliches</div>
      <h1>Impressum</h1>

      <p>
        <strong>Platzhalter:</strong> Ergänze hier vor Veröffentlichung die
        nach § 5 DDG erforderlichen Angaben passend zu deiner tatsächlichen
        Unternehmensform.
      </p>

      <p>
        Luca Schwarz<br />
        Straße und Hausnummer<br />
        PLZ Ort<br />
        Deutschland
      </p>

      <p>
        E-Mail: hello@example.de
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>
