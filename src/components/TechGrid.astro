---
const technologies = [
  'Java',
  'Spring Boot',
  'Angular',
  'TypeScript',
  'Shopify',
  'React',
  'Astro',
  'Docker',
  'AWS',
  'SQL',
  'Oracle',
  'PostgreSQL',
];
---

<div class="tech-grid">
  {technologies.map((technology) => (
    <div class="tech-item">{technology}</div>
  ))}
</div>
